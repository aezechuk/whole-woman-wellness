# Caddy gets and renews the Let's Encrypt certificate automatically
# once wellness.arthenticarts.org points at this server.
{
	email arthenticarts@gmail.com
}

{$SITE_HOST:wellness.arthenticarts.org} {
	encode zstd gzip
	request_body {
		max_size 1MB
	}
	header {
		-Server
	}
	reverse_proxy app:8000
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>headers>Cookie delete
				request>headers>Authorization delete
				request>uri query {
					delete token
				}
			}
		}
	}
}
